{
  "name": "orvalia-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://orvalia.com.br",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/clean-build.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node prerender.js",
    "preview": "vite preview",
    "verify": "node scripts/verify-navigation.mjs && node scripts/verify-sharing.mjs && node scripts/verify-blog.mjs && node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit",
    "test:contact": "node --test server/contact/contact.test.mjs",
    "test:analytics": "node --test scripts/verify-analytics.test.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
